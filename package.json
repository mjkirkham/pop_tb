{
  "name": "pop-tb",
  "version": "1.1.0",
  "description": "Fully populate an Initial or Comparative Trial Balance in Final Accounts Online",
  "private": true,
  "scripts": {
    "build:chrome": "./build.sh chrome",
    "build:firefox": "./build.sh firefox",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "watch:chrome": "webpack --env browser=chrome --mode development --watch",
    "watch:firefox": "webpack --env browser=firefox --mode development --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json,css,html}\""
  },
  "author": "Charlie Billen, Mark Kirkham",
  "license": "UNLICENSED",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^8.57.1",
    "prettier": "^3.7.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
